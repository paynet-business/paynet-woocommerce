{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/admin.php?page=wc-settings&tab=checkout&section=paynet_wc",
    "preferredVersions": {
        "php": "8.3",
        "wp": "latest"
    },
    "features": {
        "networking": true
    },
    "login": true,
    "steps": [
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "woocommerce"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/paynet-business/paynet-woocommerce",
                "ref": "main",
                "path": "/"
            },
            "options": {
                "activate": true,
                "targetFolderName": "paynet-for-woocommerce"
            }
        },
        {
            "step": "setSiteOptions",
            "options": {
                "woocommerce_currency": "MDL",
                "woocommerce_default_country": "MD",
                "woocommerce_onboarding_profile": {
                    "skipped": true
                },
                "woocommerce_paynet_wc_settings": {
                    "enabled": "yes",
                    "mode": "test",
                    "test_username": "771064",
                    "test_password": "sLgMnGWJ",
                    "test_sale_area": "onlidocumentation_md",
                    "test_notify_key": "D9873689-E5F8-4272-A67F-0D8BA3F9BAA7",
                    "payment_window": "60",
                    "debug": "yes"
                },
                "woocommerce_enable_guest_checkout": "yes",
                "woocommerce_coming_soon": "no"
            }
        },
        {
            "step": "runPHP",
            "code": "<?php require '/wordpress/wp-load.php'; $p = new WC_Product_Simple(); $p->set_name('Demo product'); $p->set_regular_price('199.99'); $p->set_status('publish'); $p->save();"
        }
    ]
}
